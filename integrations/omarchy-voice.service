[Unit]
Description=Omarchy Voice local push-to-talk backend
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/omarchy-voice serve
Restart=on-failure
RestartSec=3
TimeoutStopSec=5
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=graphical-session.target
