[Unit]
Description=Omarchy Voice local push-to-talk backend
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/omarchy-voice serve
Restart=on-failure
RestartSec=3
TimeoutStopSec=5
UMask=0077
# NoNewPrivileges is intentionally not set: it is inherited by every child
# process, so launched terminals could not use sudo. See docs/adr/0002.

[Install]
WantedBy=graphical-session.target
